# logo.dev (https://www.logo.dev). Both are optional: without them Swatch scrapes the brand's website.
# Publishable key (pk_...) for the logo image API
LOGODEV_PUBLISHABLE_KEY=
# Secret key (sk_...) for Brand Search (name -> domain)
LOGODEV_SECRET_KEY=

# OpenAI key for optional AI backgrounds (--ai). Never used with --offline or --no-ai.
OPENAI_API_KEY=

# Parallel renders (default: number of CPU cores)
SWATCH_CONCURRENCY=

# Corporate proxy, if needed. Node also needs NODE_USE_ENV_PROXY=1 to honor it.
HTTPS_PROXY=
