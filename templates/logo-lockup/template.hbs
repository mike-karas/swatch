{{> head}}
<style>
.content { display: flex; align-items: center; justify-content: center; }
.lockup { display: flex; align-items: center; gap: {{gap}}px; transform-origin: center; flex: none; }
.name {
  color: {{nameColor}}; font-size: {{nameSize}}px; font-weight: 700; line-height: 1;
  white-space: nowrap; letter-spacing: -0.01em;
}
</style>
</head>
<body>
  <div class="safe content">
    {{#if name}}
    <div class="lockup" data-fit-box>{{{logoHtml}}}<span class="name">{{name}}</span></div>
    {{else}}
    {{{logoHtml}}}
    {{/if}}
  </div>
</body>
</html>
