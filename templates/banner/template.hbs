{{> head}}
<style>
.panel {
  position: absolute; inset: 0;
  clip-path: polygon({{panelTop}}% 0, 100% 0, 100% 100%, {{panelBottom}}% 100%);
  background: linear-gradient(135deg, {{panelLight}} 0%, {{panelBg}} 60%, {{panelDark}} 100%);
}
.photo { position: absolute; inset: 0; background: url('{{{photo}}}') center / cover no-repeat; }
.stripe {
  position: absolute; inset: 0; background: {{accent}};
  clip-path: polygon({{stripeTop}}% 0, {{panelTop}}% 0, {{panelBottom}}% 100%, {{stripeBottom}}% 100%);
}
.col {
  position: absolute; left: {{safe}}px; top: {{safe}}px; bottom: {{safe}}px; width: {{colW}}px;
  display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: {{gap}}px;
}
.headline {
  width: 100%; color: {{headInk}}; font-size: {{headSize}}px; font-weight: 700;
  line-height: 1.08; letter-spacing: -0.01em; text-wrap: balance;
}
.subhead { width: 100%; color: {{ink}}; font-size: {{subSize}}px; font-weight: 400; line-height: 1.3; }
</style>
</head>
<body>
  <div class="panel">{{#if photo}}<div class="photo"></div>{{/if}}</div>
  <div class="stripe"></div>
  <div class="col">
    {{{logoHtml}}}
    {{#if headline}}<div class="headline" data-fit="2">{{headline}}</div>{{/if}}
    {{#if subhead}}<div class="subhead" data-fit="2">{{subhead}}</div>{{/if}}
  </div>
</body>
</html>
